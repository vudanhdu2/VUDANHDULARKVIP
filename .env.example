# ============================================================================
# WaytoAGI V2 — Environment configuration template
# ============================================================================
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env vào git.
# Chạy `python setup_new_project.py` để wizard tự tạo .env cho bạn.

# ─── Source CN tenant (Feishu) ────────────────────────────────────────────
SOURCE_OPEN_URL=https://open.feishu.cn/open-apis
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_SRC_SPACE=YOUR_SOURCE_SPACE_ID

# ─── DST tenant (Larksuite) ──────────────────────────────────────────────
LARK_OPEN_URL=https://open.larksuite.com/open-apis
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_DOMAIN=your-tenant.sg.larksuite.com
LARK_WORKING_SPACE=YOUR_WORKING_SPACE_ID
LARK_DST_SPACE=YOUR_DST_SPACE_ID
LARK_CN_PARENT=PARENT_NODE_TOKEN_FOR_CN_CLONE
LARK_VI_PARENT=PARENT_NODE_TOKEN_FOR_VI_MIRROR

# ─── Lark CLI ────────────────────────────────────────────────────────────
# Path tới lark-cli executable (Windows: lark-cli.cmd)
LARK_CLI_PATH=lark-cli

# ─── Lark Base table cho tracking ─────────────────────────────────────────
LARK_BASE_TOKEN=bascn_xxxxxxxxxxxxxxxxxx
LARK_TABLE_ID=tblXxxxxxxxxxxxxxx

# ─── LLM POOL ─────────────────────────────────────────────────────────────
# Path tới file llm_keys.json (xem llm_keys.example.json)
LLM_KEYS_FILE=./llm_keys.json

# ─── Rate limiting ────────────────────────────────────────────────────────
LARK_RATE_LIMIT_RPS=5
LLM_RATE_LIMIT_RPS=10

# ─── Cache + logs ────────────────────────────────────────────────────────
TRANSLATION_CACHE_DB=.cache/translations.sqlite
CACHE_DIR=./.cache
LOG_LEVEL=INFO
LOG_FORMAT=json
